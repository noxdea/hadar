module Hadar
  VERSION: String

  class Error < StandardError
  end

  module Layout
    class Definition
      attr_reader name: Symbol
      attr_reader slots: Array[Symbol]
    end

    NAMES: Array[Symbol]

    def self.fetch: (String | Symbol name) -> Definition
    def self.select: (Array[Beid::Node] nodes, ?requested: String | Symbol | nil) -> Symbol
  end

  class Slot
    attr_reader name: Symbol
    attr_reader nodes: Array[Beid::Node]
    attr_reader document: Beid::Document
    attr_reader slide_index: Integer

    def initialize: (name: String | Symbol, nodes: Array[Beid::Node], document: Beid::Document,
      deck: Deck, slide_index: Integer) -> void
    def empty?: () -> bool
    def markdown: () -> String
    def text: () -> String
    def text_for: (Beid::Node node) -> String
    def image_path: () -> String?
    def resolved_image_path: () -> String?
    def table_rows: (?table: Integer) -> Array[Array[String]]
    def replace_text: (String text) -> Slot
    def rich_text: (?editable: bool) -> Zaniah::UI::RichText
    def replace_rich_text: (Zaniah::UI::RichText value) -> Slot
    def replace_image: (String path) -> Slot
    def insert_image: (String path, ?alt: String?) -> Slot
    def replace_table_cell: (row: Integer, column: Integer, value: String, ?table: Integer) -> Slot
    def replace_code: (String text, ?block: Integer) -> Slot
    def owned_by?: (Deck deck) -> bool
  end

  class Slide
    attr_reader index: Integer
    attr_reader document: Beid::Document
    attr_reader nodes: Array[Beid::Node]
    attr_reader layout: Symbol
    attr_reader slots: Hash[Symbol, Slot]
    attr_reader theme: Theme
    attr_reader notes: String?

    def initialize: (index: Integer, document: Beid::Document, nodes: Array[Beid::Node],
      ?layout: String | Symbol | nil, theme: Theme, deck: Deck) -> void
    def slot: (String | Symbol name) -> Slot
    def title: () -> String
  end

  class Deck
    attr_reader document: Beid::Document
    attr_reader slides: Array[Slide]
    attr_reader theme: Theme
    attr_reader source_path: String?

    def initialize: (Beid::Document document, ?theme: Theme | String | nil,
      ?source_path: String?) -> void
    def self.parse: (String markdown, ?theme: Theme | String | nil) -> Deck
    def self.open: (String path, ?theme: Theme | String | nil) -> Deck
    def self.from_document: (Beid::Document document, ?theme: Theme | String | nil) -> Deck
    def slide: (Integer index) -> Slide
    def replace_text: (Slot slot, String text) -> Slot
    def replace_rich_text: (Slot slot, Zaniah::UI::RichText value) -> Slot
    def replace_table_cell: (Slot slot, row: Integer, column: Integer, value: String, ?table: Integer) -> Slot
    def replace_code: (Slot slot, String text, ?block: Integer) -> Slot
    def replace_image: (Slot slot, String path) -> Slot
    def insert_image: (Slot slot, String path, ?alt: String?) -> Slot
    def resolve_image_path: (String path) -> String
    def save: (?String path, ?overwrite: bool) -> Deck
    def external_change?: () -> bool
    def reload_if_changed: () -> bool
    def reload: () -> bool
    def watch: (?latency: Numeric, ?on_reload: ^(Deck) -> untyped) -> DeckWatcher
    def length: () -> Integer
    alias size length
    def empty?: () -> bool
  end

  class DeckWatcher
    attr_reader deck: Deck

    def initialize: (Deck deck, ?latency: Numeric, ?on_reload: ^(Deck) -> untyped) -> void
    def poll: (?timeout: Numeric) -> bool
    def close: () -> untyped
  end

  class Theme
    DEFAULTS: Hash[String, untyped]
    COLOR_KEYS: Array[String]
    FONT_KEYS: Array[String]
    SPACING_KEYS: Array[String]

    attr_reader name: String
    attr_reader colors: Hash[String, String]
    attr_reader font: Hash[String, String | Numeric]
    attr_reader spacing: Hash[String, Numeric]

    def self.default: () -> Theme
    def self.builtin: (String name) -> Theme
    def self.load: (String path) -> Theme
    def initialize: (Hash[String, untyped] value) -> void
  end

  class Renderer
    def initialize: () -> void
    def describe: (Slide slide) -> Zaniah::Describe::Node
    def build: (Slide slide) -> Zaniah::Element
    def surface: (Slide slide) -> Zaniah::Describe::Surface
  end

  class SlideList
    DEFAULT_ROW_HEIGHT: Integer

    attr_reader deck: Deck
    attr_reader element: Zaniah::UniformList
    attr_reader selected_index: Integer?

    def initialize: (Deck deck, ?renderer: Renderer, ?selected: Integer?, ?row_height: Numeric,
      ?on_select: ^(Slide, Integer) -> untyped) -> void
    def build: (width: Numeric, height: Numeric) -> Zaniah::UniformList
    def select: (Integer index) -> Slide
  end
end
